---
import type { Product } from '../../data/products';
import SectionHeader from '../SectionHeader.astro';
import StatusPill from '../StatusPill.astro';

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

<section class="more">
  <SectionHeader title="More products" label="/ index" />
  <div class="grid">
    {
      products.map((product) => (
        <a class="card" href={`/${product.slug}/`}>
          <StatusPill status={product.status === 'testing' ? 'testing' : 'live'} small />
          <div class="name">{product.name}</div>
          <div class="tagline">{product.tagline}</div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .more {
    padding-top: clamp(56px, 8vw, 96px);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 761px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 24px;
    text-decoration: none;
    color: inherit;
    background: var(--color-card-surface);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    transition: border-color 0.35s ease;
  }

  .card:hover {
    border-color: var(--color-ink);
  }

  .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 23px;
    letter-spacing: -0.01em;
  }

  .tagline {
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--color-body);
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
