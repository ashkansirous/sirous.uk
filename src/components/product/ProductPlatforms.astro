---
import type { Platform } from '../../data/products';
import SectionHeader from '../SectionHeader.astro';
import StatusPill from '../StatusPill.astro';

interface Props {
  platforms: Platform[];
}

const { platforms } = Astro.props;
---

<section class="platforms">
  <SectionHeader title="Where it runs" label="/ platforms" />
  <ul class="list">
    {
      platforms.map((platform) => (
        <li class="row">
          <span class="name">{platform.name}</span>
          <StatusPill status={platform.status} small />
          <span class="note">{platform.note}</span>
          {platform.url && (
            <a class="open" href={platform.url} rel="noopener">
              open ↗
            </a>
          )}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    padding: 14px 0;
    border-top: 1px solid var(--color-hairline-2);
  }

  .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    min-width: 130px;
  }

  .note {
    flex: 1 1 220px;
    font-size: 14px;
    color: var(--color-muted);
  }

  .open {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-ink);
    text-decoration: none;
  }

  .open:hover {
    color: var(--color-accent);
  }
</style>
