---
import { Image } from 'astro:assets';
import type { Product } from '../data/products';

interface Props {
  product: Product;
  /** `card` = home-page card (tilted, may bleed); `page` = centred showcase. */
  variant: 'card' | 'page';
}

const { product, variant } = Astro.props;
const fit = product.screenshotFit ?? 'bleed';
const isCard = variant === 'card';
const isWide = product.screenshot.width > product.screenshot.height;
const isArt = fit === 'art';
const widths = isArt ? [800, 1200, 1600] : isWide ? [480, 720, 1080] : isCard ? [320, 480, 640] : [360, 540, 720, 1080];
const sizes = getSizes(isCard, isWide);

function getSizes(card: boolean, wide: boolean): string {
  if (isArt) return '(max-width: 760px) 100vw, 520px';
  if (wide) return card ? '(max-width: 760px) 90vw, 420px' : '(max-width: 760px) 90vw, 520px';
  return card ? '(max-width: 760px) 70vw, 300px' : '(max-width: 760px) 90vw, 360px';
}
---

<div class:list={['device', `device--${variant}`, `device--${fit}`, { 'device--wide': isWide }]}>
  <Image
    src={product.screenshot}
    alt={product.screenshotAlt}
    widths={widths}
    sizes={sizes}
    loading={isCard ? 'lazy' : 'eager'}
  />
</div>

<style>
  .device {
    border-radius: var(--radius-device);
    box-shadow: var(--shadow-device);
    border: 1px solid var(--color-on-panel-edge);
    overflow: hidden;
  }

  .device img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Full-bleed artwork: fills the panel, no window chrome. The label sits above (z-index). */
  .device--art {
    position: absolute;
    inset: 0;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    transform: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    z-index: 0;
  }

  .device--art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% 50%;
  }

  /* Anchored from the top so the label stays clear; the tall screenshot bleeds off the bottom. */
  .device--card {
    position: absolute;
    left: 50%;
    top: 64px;
    bottom: auto;
    width: min(70%, 270px);
    transform: translateX(-50%) rotate(-2deg);
  }

  /* A short window: no bleed, so it sits below the label at a size that fits the panel. */
  .device--card.device--float {
    top: 64px;
    bottom: auto;
    width: min(62%, 240px);
  }

  /* A landscape window needs more width than a phone-shaped one to stay legible. */
  .device--card.device--float.device--wide {
    width: min(88%, 420px);
  }

  /* Page showcase: sits in normal flow, centred by the flex panel around it. */
  .device--page {
    position: relative;
    left: auto;
    width: min(82%, 360px);
    margin: auto;
  }

  .device--page.device--wide {
    width: min(92%, 520px);
  }

  @media (max-width: 760px) {
    .device--card {
      width: min(64%, 230px);
      top: 56px;
    }

    .device--card.device--float {
      top: 48px;
      width: min(56%, 190px);
    }

    .device--card.device--float.device--wide {
      width: min(88%, 420px);
    }
  }

  .device--card.device--art,
  .device--page.device--art,
  .device--card.device--art.device--wide,
  .device--page.device--art.device--wide {
    position: absolute;
    inset: 0;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    transform: none;
  }

  @media (max-width: 760px) {
    .device--card.device--art {
      top: 0;
      width: 100%;
    }
  }
</style>
