---
import type { Product } from '../data/products';
import StatusPill from './StatusPill.astro';
import ProductDevice from './ProductDevice.astro';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const statusText = product.status === 'testing' ? 'In testing' : 'Live';
const panelLabel = product.audience ?? statusText;
---

<a class="card" href={`/${product.slug}/`}>
  <div class="inner">
    <div class="text-panel">
      <div class="meta">
        <StatusPill status={product.status === 'testing' ? 'testing' : 'live'} />
        <span class="index">{product.index}</span>
      </div>
      <h3>{product.name}</h3>
      <p class="desc">{product.tagline}</p>
      <ul class="chips">
        {
          product.platforms.map((platform) => (
            <li class="chip">
              <span class:list={['dot', `dot--${platform.status}`]} />
              {platform.name}
            </li>
          ))
        }
      </ul>
      <div class="url">{product.displayUrl}</div>
      <div class="cta">
        <span class="cta-label">VIEW DETAILS</span>
        <span class="arrow" aria-hidden="true">→</span>
      </div>
    </div>

    <div class="panel" style={`background: var(--color-panel-${product.panel})`}>
      <span class="watermark" aria-hidden="true">↗</span>
      <span class="panel-label">{panelLabel}</span>
      <ProductDevice product={product} variant="card" />
    </div>
  </div>
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-card-surface);
    transition:
      transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 26px 50px -28px rgba(26, 22, 19, 0.4);
    border-color: var(--color-ink);
  }

  .inner {
    display: grid;
    grid-template-columns: 1.25fr 0.95fr;
    min-height: 420px;
  }

  .text-panel {
    padding: clamp(26px, 3.4vw, 44px);
    display: flex;
    flex-direction: column;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .index {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-faint);
  }

  h3 {
    margin: 0;
    padding-top: 28px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(30px, 3.6vw, 46px);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .desc {
    margin: 16px 0 0;
    font-size: 16.5px;
    line-height: 1.55;
    color: var(--color-body);
    max-width: 42ch;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 11px;
    background: var(--color-chip-surface);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink);
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .dot--live {
    background: var(--color-live);
  }

  .dot--testing {
    background: var(--color-testing);
  }

  .url {
    margin-top: 20px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-muted);
  }

  .cta {
    margin-top: auto;
    padding-top: 28px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--color-ink);
  }

  .arrow {
    color: var(--color-accent);
    font-size: 16px;
    transition: transform 0.35s ease;
  }

  .card:hover .arrow {
    transform: translateX(4px);
  }

  .panel {
    position: relative;
    overflow: hidden;
    padding: clamp(22px, 2.6vw, 34px);
    color: var(--color-accent-text);
  }

  .watermark {
    position: absolute;
    top: -18px;
    right: 8px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 200px;
    line-height: 1;
    color: var(--color-on-panel-watermark);
    pointer-events: none;
  }

  .panel-label {
    position: relative;
    z-index: 1;
    text-transform: uppercase;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--color-accent-text);
    opacity: 0.85;
  }

  /* Narrow viewports: stack the text panel above the screenshot panel. */
  @media (max-width: 760px) {
    .inner {
      grid-template-columns: 1fr;
    }

    .panel {
      min-height: 300px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .arrow {
      transition: none;
    }

    .card:hover,
    .card:hover .arrow {
      transform: none;
    }
  }
</style>
