---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<a class="card" href={product.url}>
  <div class="inner">
    <div class="text-panel">
      <div class="meta">
        <span class="live-pill">
          <span class="live-dot"></span>LIVE
        </span>
        <span class="index">{product.index}</span>
      </div>
      <h3>{product.name}</h3>
      <p class="desc">{product.description}</p>
      {product.displayUrl && <div class="url">{product.displayUrl}</div>}
    </div>

    <div class="accent-panel">
      <span class="watermark" aria-hidden="true">↗</span>
      <span class="label">OPEN&nbsp;THE&nbsp;APP</span>
      <span class="cta-dot" aria-hidden="true">→</span>
    </div>
  </div>
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-card-surface);
    transition:
      transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 26px 50px -28px rgba(26, 22, 19, 0.4);
    border-color: var(--color-ink);
  }

  .inner {
    display: grid;
    grid-template-columns: 1.45fr 0.9fr;
    min-height: 340px;
  }

  .text-panel {
    padding: clamp(26px, 3.4vw, 44px);
    display: flex;
    flex-direction: column;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .live-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-live-pill-bg);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--color-live-pill-text);
  }

  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-live);
    animation: pulseDot 1.8s ease-in-out infinite;
  }

  .index {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-faint);
  }

  h3 {
    margin: auto 0 0;
    padding-top: 28px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(30px, 3.6vw, 46px);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .desc {
    margin: 16px 0 0;
    font-size: 16.5px;
    line-height: 1.55;
    color: var(--color-body);
    max-width: 42ch;
  }

  .url {
    margin-top: 22px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-muted);
  }

  .accent-panel {
    position: relative;
    background: var(--color-accent);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: clamp(22px, 2.6vw, 34px);
    color: var(--color-accent-text);
    overflow: hidden;
  }

  .watermark {
    position: absolute;
    top: -18px;
    right: 8px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 200px;
    line-height: 1;
    color: rgba(255, 255, 255, 0.13);
    pointer-events: none;
  }

  .label {
    position: relative;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    opacity: 0.85;
  }

  .cta-dot {
    position: relative;
    width: 54px;
    height: 54px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #fff;
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
  }

  /* Narrow viewports: stack the text panel above the accent panel. */
  @media (max-width: 760px) {
    .inner {
      grid-template-columns: 1fr;
    }

    .accent-panel {
      min-height: 120px;
    }
  }
</style>
