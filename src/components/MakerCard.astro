---
import { Image } from 'astro:assets';
import { siteConfig } from '../config';
import ashkanPhoto from '../assets/ashkan.jpg';
---

<aside class="maker">
  <div class="kicker">The maker</div>
  <div class="identity">
    <Image
      class="avatar"
      src={ashkanPhoto}
      alt="Ashkan Sirous"
      width={48}
      height={48}
      loading="eager"
    />
    <div class="name-block">
      <div class="name">Ashkan Sirous</div>
      <div class="subtitle">Designs &amp; builds it all</div>
    </div>
  </div>
  <p class="bio">One person, quietly shipping software that's actually useful.</p>
  <a class="link" href={siteConfig.links.personalSite}>
    ashkan.sirous.uk <span class="accent">↗</span>
  </a>
</aside>

<style>
  .maker {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    background: var(--color-card-surface);
    padding: 22px;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-faint);
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-top: 16px;
  }

  .avatar {
    width: 48px;
    height: 48px;
    flex: 0 0 auto;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--color-hairline);
  }

  .name-block {
    line-height: 1.25;
  }

  .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.01em;
  }

  .subtitle {
    font-size: 12.5px;
    color: var(--color-faint);
  }

  .bio {
    margin: 16px 0 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .link {
    margin-top: 16px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    width: 100%;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-ink);
    border-top: 1px solid var(--color-hairline-2);
    padding-top: 14px;
  }

  .accent {
    color: var(--color-accent);
  }

  .link .accent {
    margin-left: auto;
  }
</style>
