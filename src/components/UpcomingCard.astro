---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<div class="slot">
  <div class="meta">
    <span class="pill">{product.slotLabel}</span>
    <span class="index">{product.index}</span>
  </div>
  <div class="bottom">
    <div class="title">{product.name}</div>
    <div class="subline">{product.description}</div>
  </div>
</div>

<style>
  .slot {
    border: 1.5px dashed var(--color-dashed);
    border-radius: var(--radius-card);
    min-height: 188px;
    padding: 26px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: transparent;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .pill {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--color-faint);
    border: 1px solid var(--color-dashed);
    border-radius: var(--radius-pill);
    padding: 5px 11px;
  }

  .index {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-placeholder-index);
  }

  .title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 23px;
    letter-spacing: -0.01em;
    color: var(--color-placeholder);
  }

  .subline {
    margin-top: 6px;
    font-size: 14px;
    color: var(--color-placeholder);
  }
</style>
