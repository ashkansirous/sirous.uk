---
import ProductCard from './ProductCard.astro';
import ProductSlotCard from './ProductSlotCard.astro';
import SectionHeader from './SectionHeader.astro';
import { products, reservedSlot } from '../data/products';
import { siteConfig } from '../config';
---

<section id="products" class="products">
  <SectionHeader title="Products" label="/ index" />

  <div class="stack">
    {products.map((product) => <ProductCard product={product} />)}
    {siteConfig.showUpcoming && <ProductSlotCard slot={reservedSlot} />}
  </div>
</section>

<style>
  .products {
    padding-bottom: 40px;
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
</style>
