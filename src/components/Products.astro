---
import ProductCard from './ProductCard.astro';
import UpcomingCard from './UpcomingCard.astro';
import { flagship, upcoming } from '../data/products';
import { siteConfig } from '../config';
---

<section id="products" class="products">
  <div class="section-header">
    <h2>Products</h2>
    <span class="index-label">/ index</span>
  </div>

  <ProductCard product={flagship} />

  {
    siteConfig.showUpcoming && (
      <div class="upcoming-grid">
        {upcoming.map((product) => (
          <UpcomingCard product={product} />
        ))}
      </div>
    )
  }
</section>

<style>
  .products {
    padding-bottom: 40px;
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--color-hairline);
    margin-bottom: 28px;
  }

  h2 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .index-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-faint);
  }

  .upcoming-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 20px;
  }

  /* Narrow viewports: collapse the upcoming slots to a single column. */
  @media (max-width: 760px) {
    .upcoming-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
